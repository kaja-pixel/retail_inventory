# Retail Inventory & Stock Management Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Primary Development Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skillforge_inventory_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/skillforge_inventory_db

# Dedicated Automated Testing Database (Isolated from Development)
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=skillforge_inventory_test_db
TEST_DB_USER=postgres
TEST_DB_PASSWORD=your_postgres_password
TEST_DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/skillforge_inventory_test_db

# Security & Authentication Secrets
JWT_SECRET=replace_with_a_secure_random_key_of_at_least_32_characters_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth (Optional for local testing)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Mailer (Optional)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@skillforge-inventory.com
